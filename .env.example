# Copy to .env and fill values. Never commit .env.

# GitHub (used by gh + git HTTPS creds in the container)
GH_TOKEN=

# Discord (Bot API)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_IDS=
DISCORD_USER_IDS=
# DISCORD_CHANNEL_IDS=

# Optional: Cloudflare (if you use related tools/workflows)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
